    {
      "name": "Reportes",
      "item": [
        {
          "name": "Listar reportes",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/reportes?page=1&limit=20",
              "query": [
                { "key": "comunidadId", "value": "1", "disabled": true },
                { "key": "categoria", "value": "SEGURIDAD", "disabled": true },
                { "key": "estado", "value": "PENDIENTE", "disabled": true },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Stats de reportes",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/reportes/stats",
            "description": "Conteo de reportes por estado."
          }
        },
        {
          "name": "Obtener reporte por ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/reportes/{{reporte_id}}"
          }
        },
        {
          "name": "Crear reporte (anónimo)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/reportes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Bache peligroso en Tinoco y Palacios\",\n  \"descripcion\": \"Bache de aproximadamente 50cm de diámetro frente al número 23\",\n  \"gravedad\": 4,\n  \"categoria\": \"VIALIDAD\",\n  \"fuente\": \"APP_MOVIL\",\n  \"latitud\": 17.0666,\n  \"longitud\": -96.7237,\n  \"comunidadId\": 1\n}"
            },
            "description": "No requiere autenticación. Máximo 3 reportes por día por IP (configurable)."
          }
        },
        {
          "name": "Crear reporte (autenticado)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/v1/reportes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Luminaria apagada en calle Reforma\",\n  \"descripcion\": \"Llevan 3 días sin luz en este tramo\",\n  \"gravedad\": 3,\n  \"categoria\": \"INFRAESTRUCTURA\",\n  \"fuente\": \"APP_MOVIL\",\n  \"latitud\": 17.0670,\n  \"longitud\": -96.7241,\n  \"comunidadId\": 1\n}"
            }
          }
        },
        {
          "name": "Editar reporte",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/v1/reportes/{{reporte_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Bache muy peligroso en Tinoco y Palacios\",\n  \"gravedad\": 5\n}"
            },
            "description": "Solo el autor puede editar. No aplica a reportes RESUELTO o RECHAZADO."
          }
        },
        {
          "name": "Eliminar reporte (soft delete)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/v1/reportes/{{reporte_id}}",
            "description": "Marca el reporte como eliminado (deletedAt). No se borra físicamente."
          }
        },
        {
          "name": "Cambiar estado de reporte",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/v1/reportes/{{reporte_id}}/estado",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"EN_PROCESO\",\n  \"nota\": \"Cuadrilla asignada, atenderán mañana\"\n}"
            },
            "description": "Solo SUPER_ADMIN, ADMIN o COORDINADOR. Registra entrada en historial automáticamente."
          }
        }
      ]
    },
