          "name": "Cerrar alerta",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/v1/alertas/{{alerta_id}}/cerrar",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nota\": \"Problema atendido por cuadrilla municipal\"\n}"
            },
            "description": "La alerta debe estar EN_ATENCION antes de cerrarla."
          }
        }
      ]
    },
    {
      "name": "IRSU",
      "item": [
        {
          "name": "Calcular IRSU de una comunidad",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/irsu/{{comunidad_slug}}",
            "description": "Calcula el índice IRSU global y por categoría. Genera alertas automáticamente si supera umbrales."
          }
        },
        {
          "name": "Historial IRSU de una comunidad",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/api/v1/irsu/{{comunidad_slug}}/historial?limit=30",
              "query": [
                { "key": "categoria", "value": "SEGURIDAD", "disabled": true },
                { "key": "desde", "value": "2025-01-01", "disabled": true },
                { "key": "hasta", "value": "2025-12-31", "disabled": true },
                { "key": "limit", "value": "30" }
              ]
            }
          }
        },
        {
          "name": "Dashboard stats (admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/api/v1/irsu/stats/dashboard?periodo=30D",
              "query": [{ "key": "periodo", "value": "30D", "description": "7D | 30D | 90D" }]
            },
            "description": "Serie temporal del IRSU y KPIs de reportes. Solo SUPER_ADMIN, ADMIN o COORDINADOR."
          }
        },
        {
          "name": "Recalcular IRSU de todas las comunidades",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/v1/irsu/recalcular/todas",
            "description": "Solo SUPER_ADMIN. Recalcula en lotes de 10 comunidades."
          }
        }
      ]
    },
    {
      "name": "Cuadrillas",
      "item": [
        {
          "name": "Listar cuadrillas",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/api/v1/cuadrillas?page=1&limit=50",
              "query": [
                { "key": "municipioId", "value": "1", "disabled": true },
                { "key": "activa", "value": "true", "disabled": true },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "50" }
              ]
            }
          }
        },
        {
          "name": "Crear cuadrilla",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/v1/cuadrillas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Cuadrilla Norte\",\n  \"descripcion\": \"Encargada del sector norte del municipio\",\n  \"municipioId\": 1\n}"
            }
          }
        },
        {
          "name": "Detalle de cuadrilla",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/v1/cuadrillas/{{cuadrilla_id}}"
          }
        },
        {
          "name": "Actualizar cuadrilla",
          "request": {
            "method": "PATCH",
