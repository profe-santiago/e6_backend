{
  "info": {
    "name": "IRSU — Sistema de Reportes Ciudadanos",
    "description": "Colección completa de la API REST del Sistema de Reportes Ciudadanos Geolocalizados con índice IRSU.\n\n**Base URL:** `{{base_url}}`\n\n**Autenticación:** Bearer JWT. Después de hacer login, copia el token en la variable `token` del entorno.\n\n**Entornos incluidos:**\n- Local: http://localhost:3000\n- Producción: https://e6backend-production.up.railway.app",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://e6backend-production.up.railway.app", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "reporte_id", "value": "1", "type": "string" },
    { "key": "comunidad_slug", "value": "", "type": "string" },
    { "key": "usuario_id", "value": "1", "type": "string" },
    { "key": "alerta_id", "value": "1", "type": "string" },
    { "key": "cuadrilla_id", "value": "1", "type": "string" },
    { "key": "asignacion_id", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/health",
            "description": "Verifica que el servidor esté activo."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Registrar ciudadano",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('token', body.token);",
                  "  console.log('Token guardado:', body.token.substring(0, 30) + '...');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ciudadano@ejemplo.mx\",\n  \"password\": \"MiPassword123!\",\n  \"nombre\": \"Juan Pérez\"\n}"
            },
            "description": "Registra un nuevo ciudadano. El token JWT se guarda automáticamente en la variable `token`."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('token', body.token);",
                  "  console.log('Token guardado:', body.token.substring(0, 30) + '...');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"superadmin@irsu.mx\",\n  \"password\": \"SuperAdmin2024!\"\n}"
            },
            "description": "Login con credenciales. El token JWT se guarda automáticamente en la variable `token`."
          }
        }
      ]
    },
    {
      "name": "Perfil",
      "item": [
        {
          "name": "Mi perfil",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/perfil/me",
            "description": "Perfil completo del usuario autenticado con sus comunidades suscritas."
          }
        },
        {
          "name": "Actualizar nombre",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/perfil/me",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Pérez García\"\n}"
            }
          }
        },
        {
          "name": "Mis comunidades",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/perfil/me/comunidades"
          }
        },
        {
          "name": "Suscribirse a comunidad",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/perfil/me/comunidades",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"comunidadId\": 1\n}"
            }
          }
        },
        {
          "name": "Establecer comunidad principal",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/perfil/me/comunidades/1/principal"
          }
        },
        {
          "name": "Desuscribirse de comunidad",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/perfil/me/comunidades/1"
          }
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/api/v1/usuarios?page=1&limit=20",
              "query": [
                { "key": "rol", "value": "USUARIO", "disabled": true },
                { "key": "activo", "value": "true", "disabled": true },
                { "key": "municipioId", "value": "1", "disabled": true },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Obtener usuario por ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/v1/usuarios/{{usuario_id}}"
          }
        },
        {
          "name": "Crear ADMIN",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/v1/usuarios/admin",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin.municipio@irsu.mx\",\n  \"password\": \"Admin2024!\",\n  \"nombre\": \"Admin Municipal\",\n  \"municipioId\": 1\n}"
            },
            "description": "Solo SUPER_ADMIN puede crear administradores."
          }
        },
        {
          "name": "Crear COORDINADOR",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/v1/usuarios/coordinador",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"coord.colonia@irsu.mx\",\n  \"password\": \"Coord2024!\",\n  \"nombre\": \"Coordinador Colonia\",\n  \"comunidadId\": 1\n}"
            }
          }
        },
        {
          "name": "Crear OPERADOR",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/v1/usuarios/operador",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"operador1@irsu.mx\",\n  \"password\": \"Operador2024!\",\n  \"nombre\": \"Operador Cuadrilla Norte\",\n  \"municipioId\": 1\n}"
            }
          }
        },
        {
          "name": "Desactivar usuario",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/v1/usuarios/{{usuario_id}}/desactivar"
          }
        },
        {
          "name": "Activar usuario",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/v1/usuarios/{{usuario_id}}/activar"
          }
        }
      ]
    },
